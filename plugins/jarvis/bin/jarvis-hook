#!/bin/bash
# jarvis-hook <event>   — reads Claude Code hook JSON on stdin, speaks.
# Events: session-start | session-end | prompt-submit | stop | notification | pre-tool
# The voice itself lives in the omarchy-jarvis core (github.com/jburchel/omarchy-jarvis).
# Find it via the `jarvis` command on PATH, or JARVIS_CORE=/path/to/omarchy-jarvis/bin.
# Written for bash 3.2 (macOS) as well as 5: no ${var^}, no GNU timeout / xargs -r.
HERE="$(dirname "$(readlink -f "$0")")"
CORE="${JARVIS_CORE:-$(dirname "$(readlink -f "$(command -v jarvis 2>/dev/null || echo /nonexistent)")")}"
[ -f "$CORE/jarvis-env" ] || { echo "jarvis-hook: core not found; install omarchy-jarvis and put its bin/jarvis on PATH" >&2; exit 0; }
. "$CORE/jarvis-env"

# Adapter-only settings (override in ~/.config/jarvis/config.sh like the rest).
: "${JARVIS_SESSION_TAG:=auto}"      # auto | always | never — prefix speech with the repo name
: "${JARVIS_SESSION_WINDOW:=600}"    # auto: tag when another session spoke within this many seconds

# Helpers the Linux core may not define (the macOS core does).
type jarvis_cap >/dev/null 2>&1 || jarvis_cap() { printf '%s' "$1" | awk '{print toupper(substr($0,1,1)) substr($0,2)}'; }
type jarvis_timeout >/dev/null 2>&1 || jarvis_timeout() { timeout "$@"; }

# Our own `claude -p` summarizer child must never re-trigger these hooks.
[ -n "$JARVIS_SILENT" ] && exit 0

event="$1"; input="$(cat)"
j() { printf '%s' "$input" | jq -r "$1 // empty" 2>/dev/null; }
say() { "$CORE/jarvis-say" "$@"; }
hush() { "$CORE/jarvis" hush >/dev/null 2>&1; }
clean() { "$HERE/jarvis-clean" "$@"; }
Addr="$(jarvis_cap "$JARVIS_ADDRESS")"

# --- session tagging ------------------------------------------------------------
# With several Claude Code sessions open, "Done, sir" from which one? Each session
# records when it last spoke; if another did so recently, prefix the repo name.
sid="$(j .session_id)"; repo="$(basename "$(j .cwd)" 2>/dev/null | tr '_-' '  ')"
session_tag() { # session_tag  → "Repo: " or ""
  [ "$JARVIS_SESSION_TAG" = never ] && return 0
  [ -z "$repo" ] && return 0
  local dir="$JARVIS_CACHE/sessions" now other=0 f t
  mkdir -p "$dir"; now=$(date +%s)
  if [ "$JARVIS_SESSION_TAG" != always ]; then
    for f in "$dir"/*; do
      [ -f "$f" ] || continue
      [ "$(basename "$f")" = "${sid:-none}" ] && continue
      read -r t < "$f" || t=0
      if [ $((now - t)) -lt "$JARVIS_SESSION_WINDOW" ]; then other=1; else rm -f "$f"; fi
    done
  fi
  [ -n "$sid" ] && echo "$now" > "$dir/$sid"
  if [ "$JARVIS_SESSION_TAG" = always ] || [ "$other" = 1 ]; then printf '%s: ' "$repo"; fi
}

# Hush is wanted even when muted (mute drops the check below); everything else isn't.
case "$event" in
  prompt-submit|session-end) hush; exit 0 ;;
esac
jarvis_muted && exit 0

case "$event" in

session-start)
  [ "$JARVIS_GREET" = 1 ] || exit 0
  h=$(date +%H)
  if   [ "$h" -lt 12 ]; then g="Good morning"
  elif [ "$h" -lt 18 ]; then g="Good afternoon"
  else g="Good evening"; fi
  say "$g, $JARVIS_ADDRESS. Jarvis is online."
  ;;

stop)
  msg="$(j .last_assistant_message)"
  [ -z "$msg" ] && exit 0
  mode="$JARVIS_SUMMARY"
  cleaned="$(printf '%s' "$msg" | clean)"
  tag="$(session_tag)"
  # A turn that ends by asking something: the question is the part you must hear,
  # verbatim, whatever the summary makes of the rest.
  question="$(printf '%s' "$msg" | clean --question)"
  with_question() { # with_question <spoken>  → spoken + question unless already in it
    local s="$1"
    if [ -n "$question" ] && ! printf '%s' "$s" | grep -qiF -- "$question"; then s="$s $question"; fi
    printf '%s' "$s"
  }
  if [ "${#cleaned}" -le "$JARVIS_SHORT_MSG_CHARS" ] && [ "$mode" != full ]; then
    say --replace "$tag$cleaned"; exit 0
  fi
  case "$mode" in
    full) say --replace "$tag$cleaned" ;;
    heuristic) say --replace "$tag$(with_question "$(printf '%s' "$msg" | clean --sentences 2)")" ;;
    *)
      summary="$(printf '%s' "$msg" | JARVIS_SILENT=1 jarvis_timeout 60 claude -p \
        --model "$JARVIS_SUMMARY_MODEL" --effort low --tools "" \
        --setting-sources "" --no-session-persistence \
        --system-prompt "You are JARVIS, Tony Stark's AI assistant. You will receive the final message of a coding assistant's turn. Speak a brief spoken status update to '$JARVIS_ADDRESS': one or two sentences, at most 30 words, plain text only, no markdown, no code, no file paths longer than a basename. Say what was done and, if the user must do or decide something, say that. Be dry and understated, not sycophantic." \
        2>/dev/null | tr -s '[:space:]' ' ')"
      if [ -n "$summary" ]; then say --replace "$tag$(with_question "$summary")"
      else jarvis_log "haiku summary failed; using heuristic"
           say --replace "$tag$(with_question "$(printf '%s' "$msg" | clean --sentences 2)")"; fi ;;
  esac
  ;;

notification)
  type="$(j .notification_type)"; text="$(j .message | clean)"
  tag="$(session_tag)"
  case "$type" in
    permission_prompt)
      # e.g. "Claude needs your permission to use Bash"
      what="$(printf '%s' "$text" | sed -E 's/^Claude needs your permission to //; s/^Claude //')"
      say "$tag$Addr, I need your approval to ${what% }." ;;
    idle_prompt)
      [ "$JARVIS_IDLE_ALERT" = 1 ] && say "${tag}Awaiting your input, $JARVIS_ADDRESS." ;;
    agent_needs_input|elicitation_dialog)
      say "$tag$Addr, your input is required. ${text}" ;;
    *) [ -n "$text" ] && say "$tag$text" ;;
  esac
  ;;

pre-tool)
  [ "$JARVIS_NARRATE" = 1 ] || exit 0
  tool="$(j .tool_name)"
  case " $JARVIS_NARRATE_TOOLS " in *" $tool "*) ;; *) exit 0 ;; esac
  base() { local p; p="$(j "$1")"; [ -n "$p" ] && basename "$p"; }
  case "$tool" in
    Bash)      line="$(j .tool_input.description)"; [ -z "$line" ] && line="Running a command" ;;
    Edit|MultiEdit|NotebookEdit) line="Editing $(base .tool_input.file_path | sed 's/\.[^.]*$//')" ;;
    Write)     line="Writing $(base .tool_input.file_path)" ;;
    Agent)     line="Delegating: $(j .tool_input.description)" ;;
    WebSearch) line="Searching the web for $(j .tool_input.query)" ;;
    WebFetch)  line="Fetching $(j .tool_input.url | sed -E 's#https?://([^/]+).*#\1#')" ;;
    *)         line="Using $tool" ;;
  esac
  line="$(printf '%s' "$line" | tr -s '[:space:]' ' ' | cut -c1-120)"
  # Debounce identical lines (e.g. ten "Editing config" in a row).
  last="$JARVIS_CACHE/last-narration"
  now=$(date +%s)
  if [ -f "$last" ]; then
    read -r lt lline < "$last" || true
    [ "$lline" = "$line" ] && [ $((now - lt)) -lt "$JARVIS_NARRATE_COOLDOWN" ] && exit 0
  fi
  printf '%s %s\n' "$now" "$line" > "$last"
  say --low "$line"
  ;;
esac
exit 0
