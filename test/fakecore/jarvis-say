#!/bin/bash
# Fake jarvis-say: record flags + text instead of speaking.
. "$(dirname "$0")/jarvis-env"
flags=""
while [ $# -gt 0 ]; do case "$1" in --*) flags="$flags$1 "; shift ;; *) break ;; esac; done
text="$*"; [ -z "$text" ] && text="$(cat)"
printf '%s%s\n' "$flags" "$text" >> "$JARVIS_CACHE/spoken"
